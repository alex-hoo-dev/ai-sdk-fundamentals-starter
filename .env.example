# Vercel AI Gateway Authentication
# Choose one of the following authentication methods:

# Option 1: OIDC Token (recommended for local development)
# This is automatically generated when you run:
# vercel env pull
VERCEL_OIDC_TOKEN=

# Option 2: API Key (for production or CI/CD)
# Create at: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# Note: VERCEL_AI_GATEWAY_URL is NOT read by @ai-sdk/gateway — setting it has no
# effect. The gateway base URL can only be set in code, via
# createGatewayProvider({ baseURL }).

# Note: AI provider API keys (OpenAI, Anthropic, etc.) should be configured
# in the Vercel Dashboard under AI Gateway → Integrations, not in this file

# --- New API (self-hosted, OpenAI-compatible) ---
# Used by app/(1-extraction)/extraction.ts instead of the Vercel AI Gateway.
# The base URL must include the /v1 suffix.
NEWAPI_BASE_URL=https://your-new-api-host/v1
NEWAPI_API_KEY=sk-...
# Model name as configured in your New API dashboard (defaults to gpt-5.5)
# NEWAPI_MODEL=gpt-5.5